{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "ECommerce": "Debug"
      }
    }
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    }
  }
}